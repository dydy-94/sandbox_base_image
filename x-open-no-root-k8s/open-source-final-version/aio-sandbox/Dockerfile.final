# =============================================================================
# AIO Sandbox — final merged Dockerfile (offline + patch consolidated)
#
# Origin: open-source aio-sandbox reverse-engineered from
#   ghcr.io/agent-infra/sandbox (run on enterprise-public-cn-beijing.cr.volces.com)
# This is the consolidation of:
#   * Dockerfile.offline  (v13-fix9 base, CN-mirror, offline-first)
#   * Dockerfile.offline.patch (v13-fix9.4..9.11 no-root / dbus / priority fixes)
#   * Dockerfile.patch (v13-fix9.10-clipboard-test variant)
#
# Build design:
#   1. ALL large package downloads (apt .deb, pip wheels, npm tgz, cargo
#      registry) happen on the HOST before build, via the prepare-* scripts
#      in docker/context/prepare-*.sh. The Dockerfile only uses those
#      pre-staged assets via plain COPY and offline install flags
#      (`pip install --no-index --find-links ...`, `apt-get install --no-download`,
#      `npm install --prefer-offline`). Build-time network access is allowed
#      as a safety net — every install command has `|| echo "WARN: ..."`
#      so a single mirror flake never breaks the build.
#   2. ALL .so fix-up happens at BUILD time. Container entrypoint does NO
#      detection, NO reinstall, NO network. `docker run aio-sandbox`
#      brings up supervisord in seconds, not minutes.
#   3. USER=x (uid/gid 1000). supervisord runs as PID 1 root and drops
#      privileges per-program via `[program:...] user=x`. daytona + pm2
#      + mcp2rest + dbus-session + fcitx5 + chrome all run as x.
#   4. ENTRYPOINT: /opt/application/init-once.sh → /opt/application/run.sh
#      → supervisord. All port defaults via ENV; nginx configs rendered at
#      runtime from those ENVs.
# =============================================================================

# ----- Build-time network mirrors (used as a build-time fallback only) -----
ARG PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
ARG UV_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# DISABLE_CODE=true: code-server + mcp2rest are not required.
ARG DISABLE_CODE=true

ARG NPM_REGISTRY=https://registry.npmmirror.com
ARG APT_MIRROR=http://mirrors.aliyun.com/ubuntu
ARG APT_FALLBACK_MIRRORS=http://mirrors.cloud.tencent.com/ubuntu,http://mirrors.ustc.edu.cn/ubuntu,http://mirrors.tuna.tsinghua.edu.cn/ubuntu
ARG GOPROXY=https://goproxy.cn,direct

# ----- Toolchain versions (pinned so pre-staged assets match) -----
ARG PY313_VERSION=3.13
ARG NODE22_VERSION=22.22.3
ARG FNM_VERSION=1.39.0
ARG UV_VERSION=0.11.19
ARG MCP_SERVER_BROWSER_VERSION=1.2.29
ARG VE_VERSION=1.0.45


# =============================================================================
# Stage 1 — uv binary
# =============================================================================
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.11.19
FROM ${UV_IMAGE} AS uvbin


# =============================================================================
# Stage 2 — aio client bundle (npm build)
# =============================================================================
FROM node:22-slim AS aio-build
WORKDIR /build/aio
COPY docker/context/npm-tgz/aio/ /tmp/npm-tgz/
COPY docker/context/aio/package.json docker/context/aio/package-lock.json ./
ARG NPM_REGISTRY
RUN npm install --no-fund --no-audit --prefer-offline /tmp/npm-tgz/*.tgz 2>/dev/null \
    || npm ci --no-fund --no-audit --registry ${NPM_REGISTRY}
COPY docker/context/aio/build.mjs ./build.mjs
COPY docker/context/aio/src ./src
RUN npm run build   # -> /build/aio/dist/aio.js


# =============================================================================
# Stage 3 — static assets bundle
# =============================================================================
FROM node:22-slim AS static-assets
WORKDIR /assets
COPY docker/context/npm-tgz/static-assets/ /tmp/npm-tgz/
COPY docker/context/static-assets/package.json docker/context/static-assets/package-lock.json ./
ARG NPM_REGISTRY
RUN npm install --no-fund --no-audit --ignore-scripts --prefer-offline /tmp/npm-tgz/*.tgz 2>/dev/null \
    || npm ci --no-fund --no-audit --ignore-scripts --registry ${NPM_REGISTRY}
RUN bash -lc 'D=/out/var/www/app/static/sandbox; \
    mkdir -p "$D/swagger-ui-dist@5" "$D/xterm@5.3.0/lib" "$D/xterm@5.3.0/css" \
             "$D/xterm-addon-fit@0.8.0/lib" "$D/clipboard@2.0.11" \
             "$D/agent-infra-browser-ui@0.2.2"; \
    cp node_modules/swagger-ui-dist/swagger-ui-bundle.js           "$D/swagger-ui-dist@5/swagger-ui-bundle.js" && \
    cp node_modules/swagger-ui-dist/swagger-ui.css                 "$D/swagger-ui-dist@5/swagger-ui.css" && \
    cp node_modules/xterm/lib/xterm.js                             "$D/xterm@5.3.0/lib/xterm.js" && \
    cp node_modules/xterm/css/xterm.css                            "$D/xterm@5.3.0/css/xterm.css" && \
    cp node_modules/xterm-addon-fit/lib/xterm-addon-fit.js         "$D/xterm-addon-fit@0.8.0/lib/xterm-addon-fit.js" && \
    cp node_modules/clipboard/dist/clipboard.min.js                "$D/clipboard@2.0.11/clipboard.min.js" && \
    cp node_modules/@agent-infra/browser-ui/dist/bundle/index.js             "$D/agent-infra-browser-ui@0.2.2/index.js" && \
    cp node_modules/@agent-infra/browser-ui/dist/bundle/index.js.LICENSE.txt "$D/agent-infra-browser-ui@0.2.2/index.js.LICENSE.txt" && \
    echo "static-assets OK"'


# =============================================================================
# Stage 4 — VE (placeholder; upstream aio-x/ve was archived in 2025).
# Build a minimal placeholder so /usr/local/bin/ve always exists.
# =============================================================================
FROM golang:1.23-bookworm AS ve-build
ARG VE_VERSION=1.0.45
ARG TARGETARCH
ARG GOPROXY
ENV CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} GOPROXY=${GOPROXY} GOSUMDB=off
RUN (go install -trimpath -ldflags "-s -w -X main.version=${VE_VERSION}" \
        github.com/aio-x/ve@${VE_VERSION} 2>/dev/null && \
     echo "ve built from upstream") || \
    (echo '#!/bin/sh' > /tmp/ve-placeholder && \
     echo 'echo "ve: upstream package not available; continuing without it" >&2' >> /tmp/ve-placeholder && \
     chmod +x /tmp/ve-placeholder && \
     mkdir -p /go/bin && mv /tmp/ve-placeholder /go/bin/ve)
RUN if [ ! -f /go/bin/ve ]; then \
        echo '#!/bin/sh' > /go/bin/ve && \
        echo '# ve placeholder - upstream aio-x/ve unavailable' >> /go/bin/ve && \
        chmod +x /go/bin/ve; \
    fi


# =============================================================================
# Stage 5 — final image
# =============================================================================
FROM ubuntu:26.04 AS builder

ARG PY313_VERSION
ARG NODE22_VERSION
ARG FNM_VERSION
ARG MCP_SERVER_BROWSER_VERSION
ARG TARGETARCH

ENV DEBIAN_FRONTEND=noninteractive

# ===== 1. apt retry / timeouts =====
RUN printf 'Acquire::http::Timeout "180";\nAcquire::https::Timeout "180";\nAcquire::http::Pipeline-Depth "10";\nAcquire::https::Pipeline-Depth "10";\nAcquire::Retries "20";\nAcquire::ForceIPv4 "true";\n' > /etc/apt/apt.conf.d/99retries

# ===== 2. apt CN mirror + offline .deb install =====
ARG APT_MIRROR
ARG APT_FALLBACK_MIRRORS
RUN set -eux; \
    rm -f /etc/apt/sources.list.d/*.sources /etc/apt/sources.list 2>/dev/null; \
    printf 'Types: deb\nURIs: %s\nSuites: resolute resolute-updates\nComponents: main universe restricted multiverse\nSigned-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg\n' \
        "${APT_MIRROR}" > /etc/apt/sources.list.d/cn-mirror.sources

# Pre-staged .deb cache (prepare-apt-archives.sh on the host)
COPY docker/context/apt-archives/ /opt/apt-archives/

# Phase 1: offline install from /opt/apt-archives
# Phase 2: network install from CN mirror as fallback
RUN bash -c 'set -x; set +e; ok=0; for try in 1 2 3 4 5; do echo "=== apt-get update attempt $try ==="; if apt-get update -o Dir::Etc::sourcelist=/etc/apt/sources.list.d/cn-mirror.sources -o Acquire::http::No-Cache=True -o Acquire::Retries=5 -o Acquire::http::Timeout=120 2>&1 | tail -8; then ok=1; break; fi; sleep 4; done; [ $ok = 0 ] && echo WARN_apk_update_failed; exit 0'

RUN mkdir -p /var/cache/apt/archives && (cp -an /opt/apt-archives/*.deb /var/cache/apt/archives/ 2>/dev/null || true) && true

# Big apt install: PKGS list with retry. libcrypt-dev (a hard dep of
# build-essential) isn't in the offline cache, so online fallback is mandatory.
# python-server removed: dropped cmake/ninja/meson/gettext/gawk/libffi-dev/
# libcairo2-dev/libpango1.0-dev/freeglut3-dev (only used for python-server wheels).
RUN bash -c 'set +e; ok=0; for try in 1 2 3 4 5; do echo "=== apt-get install attempt $try ==="; if apt-get install -y --no-install-recommends --fix-missing build-essential gcc make pkg-config python3-dev ca-certificates curl wget git gh jq file unzip zip tree htop lsof psmisc sudo software-properties-common gnupg vim net-tools netcat-openbsd iputils-ping telnet ripgrep python3 python3-venv python3-dev python3-pip nginx supervisor tigervnc-standalone-server openbox autocutsel x11-utils x11-xserver-utils xauth xclip xdotool xdg-utils gnome-screenshot im-config dbus dbus-x11 fcitx5 fcitx5-chinese-addons fcitx5-frontend-gtk3 fcitx5-frontend-qt5 ffmpeg libopenal1 libfreetype6 imagemagick libnss3 libnspr4 libgbm1 libdrm2 libgtk-3-0t64 libasound2t64 libcups2t64 libatk1.0-0t64 libatk-bridge2.0-0t64 libatspi2.0-0t64 libxcomposite1 libxdamage1 libxfixes3 libxrandr2 libxkbcommon0 libwayland-client0 libvulkan1 libxext6 libxv1 libgcrypt20 libglib2.0-0t64 libgl1 libcairo2 libpango-1.0-0 fontconfig fonts-dejavu fonts-liberation fonts-noto-core fonts-noto-cjk fonts-noto-color-emoji xfonts-intl-chinese locales tzdata bubblewrap openssh-client 2>&1 | tail -8; then ok=1; break; fi; sleep 5; done; [ $ok = 0 ] && echo WARN_apk_install_failed; \
    command -v python3 >/dev/null 2>&1 && \
    command -v curl    >/dev/null 2>&1 && \
    command -v wget    >/dev/null 2>&1 && \
    command -v git     >/dev/null 2>&1 && \
    command -v jq      >/dev/null 2>&1 && \
    command -v nginx   >/dev/null 2>&1 && \
    command -v supervisord >/dev/null 2>&1 && \
    command -v bwrap   >/dev/null 2>&1'

RUN rm -rf /var/cache/apt/archives/*.deb /var/lib/apt/lists/* 2>/dev/null || true; \
    rm -rf /opt/apt-archives 2>/dev/null || true

# ===== 2a. im-config — now in the main §2 apt list (offline .deb) =====
# (removed network-only install; im-config_*.deb ships in docker/context/apt-archives)

# Create python -> python3 symlink (ubuntu:26.04 ships only python3).
RUN if ! command -v python3 >/dev/null 2>&1; then \
        echo "WARN: python3 missing from cached apt layer, installing..."; \
        apt-get update -o Dir::Etc::sourcelist=/etc/apt/sources.list.d/cn-mirror.sources \
                       -o Acquire::http::No-Cache=True -o Acquire::Retries=5 -o Acquire::http::Timeout=120 && \
        apt-get install -y --no-install-recommends python3 python3-pip && \
        rm -rf /var/cache/apt/archives/*.deb /var/lib/apt/lists/* 2>/dev/null || true; \
    fi && \
    ln -sf /usr/bin/python3 /usr/bin/python && \
    (ln -sf /usr/bin/pip3 /usr/bin/pip 2>/dev/null || true) && \
    python --version

# ===== 2b. oras (OCI Registry As Storage) — pre-staged binary =====
# docker/context/bin/oras/oras is downloaded on the host by prepare-all.sh
# (oras_<ver>_linux_amd64.tar.gz). Offline-first; network fallback kept so a
# context built without running prepare still succeeds.
COPY docker/context/bin/oras /opt/oras-pre/
RUN set +e; \
    if [ -x /opt/oras-pre/oras ]; then \
        cp /opt/oras-pre/oras /usr/local/bin/oras && chmod +x /usr/local/bin/oras; \
    else \
        echo "WARN: pre-staged oras missing; downloading..."; \
        curl -fsSL -o /tmp/oras.tar.gz \
            "https://github.com/oras-project/oras/releases/download/v1.3.1/oras_1.3.1_linux_amd64.tar.gz" \
        && mkdir -p /tmp/oras-install \
        && tar -zxf /tmp/oras.tar.gz -C /tmp/oras-install \
        && mv /tmp/oras-install/oras /usr/local/bin/oras \
        && chmod +x /usr/local/bin/oras \
        && rm -rf /tmp/oras.tar.gz /tmp/oras-install; \
    fi; \
    rm -rf /opt/oras-pre; \
    oras version || echo "WARN: oras unavailable"

# ===== 2c. fastmcp (pip) — ubuntu 26.04 has PEP 668 managed env =====
ARG FORCE_FASTMCP_REBUILD=1
RUN echo "FORCE_FASTMCP_REBUILD=${FORCE_FASTMCP_REBUILD}" \
    && pip3 install --no-cache-dir --break-system-packages --retries 3 --timeout 60 fastmcp \
        --index-url ${PIP_INDEX_URL} \
    || pip3 install --no-cache-dir --break-system-packages fastmcp \
    || echo "WARN: fastmcp install failed; continuing"

# ===== 3. locale =====
RUN apt-get update -o Dir::Etc::sourcelist=/etc/apt/sources.list.d/cn-mirror.sources -o Acquire::http::No-Cache=True 2>&1 \
        || echo "WARN: apt-get update failed; locale generation may fail"; \
    apt-get install -y --no-install-recommends locales 2>/dev/null \
        || echo "WARN: locales install failed; locale-gen will be unavailable"; \
    sed -i -e 's/# en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen 2>/dev/null; \
    sed -i -e 's/^en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen 2>/dev/null; \
    printf 'en_US.UTF-8 UTF-8\n' >> /etc/locale.gen; \
    if command -v locale-gen >/dev/null 2>&1; then \
        locale-gen; \
    else \
        echo "WARN: locale-gen not available; container LANG will fall back to POSIX"; \
    fi
ENV LANG=en_US.UTF-8 LANGUAGE=en_US:en LC_ALL=en_US.UTF-8

# ===== 3a. timezone (China Standard Time) =====
# TZ env flows into supervisord → chrome (--time-zone-for-testing=${TZ} in run.sh).
# tzdata ships in the §2 apt list; ln /etc/localtime for system-wide tools.
ENV TZ=Asia/Shanghai
RUN ln -snf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime \
    && echo "Asia/Shanghai" > /etc/timezone \
    && date +"%Y-%m-%d %H:%M:%S %Z"

# ===== 4. user (x) =====
ENV USER=x
ENV USER_UID=1000
ENV USER_GID=1000
ENV HOME=/home/x
ENV NPM_CONFIG_PREFIX=/home/x/.npm-global
ENV NPM_CONFIG_CACHE=/home/x/.npm
ENV PUBLIC_PORT=8080 \
    VNC_SERVER_PORT=5900 \
    WEBSOCKET_PROXY_PORT=5700 \
    SANDBOX_SRV_PORT=9988 \
    JUPYTER_LAB_PORT=8888 \
    CODE_SERVER_PORT=8443 \
    MCP_SERVER_BROWSER_PORT=8100 \
    BROWSER_REMOTE_DEBUGGING_PORT=9222 \
    BROWSER_EXECUTABLE_PATH=/opt/google/chrome/chrome \
    PUPPETEER_EXECUTABLE_PATH=/opt/google/chrome/chrome \
    AGENT_BROWSER_EXECUTABLE_PATH=/opt/google/chrome/chrome \
    BROWSER_COMMANDLINE_ARGS="--no-sandbox --disable-dev-shm-usage --disable-gpu --remote-allow-origins=* --remote-debugging-port=9222 --remote-debugging-address=0.0.0.0 --start-maximized --disable-blink-features=AutomationController --disable-features=IPH_DesktopCustomizeChrome,IsolateOrigins,site-per-process --disable-focus-on-load --disable-infobars --disable-popup-blocking --disable-prompt-on-repost --disable-renderer-backgrounding --disable-site-isolation-trials --disable-window-activation --mute-audio --suppress-message-center-popups --homepage=about:blank --disable-background-timer-throttling --disable-external-intent-requests" \
    PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
RUN bash -c 'set +e; \
    userdel -r ubuntu 2>/dev/null; groupdel ubuntu 2>/dev/null; \
    if ! getent group x >/dev/null 2>&1; then groupadd -g ${USER_GID:-1000} x; fi; \
    if ! id -u x >/dev/null 2>&1; then useradd -m -s /bin/bash -u ${USER_UID:-1000} -g x x; else echo "x user already exists, reusing"; fi; \
    mkdir -p /etc/supervisor/conf.d; chown -R 1000:1000 /etc/supervisor /home/x 2>/dev/null || true; exit 0'

# ===== 4a. x has NO sudo (fully unprivileged) =====
# x is NOT a member of the sudo group and has NO sudoers entries: code
# running as x (browser pages, pasted commands) can never escalate to root,
# whether the container boots as root (docker) or uid-1000 (k8s runAsUser).
# No chpasswd, no /etc/sudoers.d/x. The sudo(8) binary stays installed (part
# of the §2 apt list) but is unusable without a sudoers rule.

# ===== 4b. bwrap (bubblewrap) directory-isolation sandbox =====
# bwrap ships in the §2 apt list. It runs rootless via unprivileged user
# namespaces, which the kernel must allow (kernel.unprivileged_userns_clone=1
# on some kernels/distros). x has no sudo, so this cannot be flipped at
# runtime — attempt it once here at build time; inside a non-privileged
# build/container /proc/sys is read-only, in which case the platform must
# grant userns via k8s securityContext.sysctls / privileged / seccomp.
RUN { sysctl -w kernel.unprivileged_userns_clone=1 2>/dev/null \
        && echo "userns sysctl OK at build time"; } \
    || echo "WARN: cannot set kernel.unprivileged_userns_clone=1 (read-only /proc/sys); platform must grant userns"; \
    bwrap --version

# ===== 5. copy uv binary from Stage 1 =====
COPY --from=uvbin /uv /uvx /usr/local/bin/

# ===== 6. python interpreters =====
# ubuntu:26.04 (resolute) ships ONLY python3 = 3.14 — no python3.13 in the
# distro repos, and GitHub (python-build-standalone) is unreachable from the
# build network. Compile python 3.13 from source via the aliyun mirror.
# /opt/python3.13/bin/python3.13 is the canonical 3.13 entrypoint (real
# binary, --enable-shared + rpath so it finds libpython3.13.so);
# /opt/python3/bin/python3 aliases the distro python3 (3.14).
ARG PY313_PATCH=9
RUN apt-get install -y --no-install-recommends \
        libssl-dev zlib1g-dev libbz2-dev libffi-dev liblzma-dev \
        libreadline-dev libsqlite3-dev libncurses-dev libgdbm-dev libdb-dev 2>/dev/null \
        || echo "WARN: python build deps install failed; build may fail"; \
    mkdir -p /opt/python3.13/bin /opt/python3/bin; \
    if curl -fsSL -m 600 -o /tmp/py.tgz \
            "https://mirrors.aliyun.com/python-release/source/Python-${PY313_VERSION}.${PY313_PATCH}.tgz" \
        && tar -zxf /tmp/py.tgz -C /tmp \
        && cd /tmp/Python-${PY313_VERSION}.${PY313_PATCH} \
        && ./configure --prefix=/opt/python3.13 --enable-shared \
                LDFLAGS="-Wl,-rpath,/opt/python3.13/lib" >/dev/null 2>&1 \
        && make -j"$(nproc)" >/dev/null 2>&1 \
        && make install >/dev/null 2>&1; then \
        echo "python ${PY313_VERSION}.${PY313_PATCH} built from source OK"; \
    else \
        echo "WARN: python ${PY313_VERSION} build failed; /opt/python3.13/bin stays empty"; \
    fi; \
    rm -rf /tmp/py.tgz /tmp/Python-${PY313_VERSION}.${PY313_PATCH}; \
    ln -sfn /usr/bin/python3 /opt/python3/bin/python3; \
    /opt/python3.13/bin/python3.13 --version 2>/dev/null || echo "WARN: python3.13 unavailable"; \
    /opt/python3/bin/python3 --version

# ===== 6a. unify the whole python ecosystem to 3.13 =====
# distro python3 stays python3.14 under the hood (dpkg dependency integrity),
# but EVERY user-facing entrypoint now resolves to the source-built 3.13:
# python3 / python / python3-config / pip3 / pip. supervisor + fastmcp were
# installed under 3.14 earlier in the build (§2c) — reinstalling them via the
# 3.13 pip keeps supervisord and the mcp tooling working under 3.13.
ARG PIP_INDEX_URL
RUN ln -sfn /opt/python3.13/bin/python3.13 /usr/bin/python3 && \
    ln -sfn /opt/python3.13/bin/python3.13 /usr/bin/python && \
    ln -sfn /opt/python3.13/bin/python3.13-config /usr/bin/python3-config && \
    ln -sfn /opt/python3.13/bin/pip3.13 /usr/bin/pip3 && \
    ln -sfn /opt/python3.13/bin/pip3.13 /usr/bin/pip && \
    ln -sfn /opt/python3.13/bin/python3.13 /opt/python3/bin/python3 && \
    pip3 install --no-cache-dir --retries 3 --timeout 60 supervisor \
        --index-url ${PIP_INDEX_URL} \
    || pip3 install --no-cache-dir supervisor \
    || echo "WARN: supervisor 3.13 reinstall failed; supervisord may not start"; \
    pip3 install --no-cache-dir --retries 3 --timeout 60 fastmcp \
        --index-url ${PIP_INDEX_URL} \
    || pip3 install --no-cache-dir fastmcp \
    || echo "WARN: fastmcp 3.13 reinstall failed; continuing"; \
    # nacos-sdk-python: must keep the classic `import nacos` API. 3.x
    # (latest) switched to a namespaced v2.nacos import, and no 1.1.0+
    # exists on the 1.x line (1.x caps at 1.0.0) — so pin <3 to land on
    # 2.0.11, which still ships the classic nacos/ top-level package.
    pip3 install --no-cache-dir --retries 3 --timeout 60 "PyYAML>=6.0" "nacos-sdk-python>=1.1.0,<3" \
        --index-url ${PIP_INDEX_URL} \
    || pip3 install --no-cache-dir "PyYAML>=6.0" "nacos-sdk-python>=1.1.0,<3" \
    || echo "WARN: PyYAML/nacos-sdk-python install failed; continuing"; \
    python3 -c "import yaml, nacos; print('PyYAML', yaml.__version__, '| nacos-sdk-python', nacos.__version__)" 2>/dev/null \
    || echo "WARN: PyYAML/nacos import check failed"; \
    python3 --version && pip3 --version && \
    /usr/bin/supervisord --version

# ===== 7. fnm + node (multi-version) =====
# NOTE: we deliberately do NOT apt-get install chromium-browser here. The
# apt cache is wiped between this stage and the chrome install in §9, and
# chromium-browser is later dpkg-purged in §18 deep-cleanup. The original
# script also pulled it; that worked because of ordering (chromium-browser
# was still in the cache at the time of §7). Keep the apt install best-
# effort (`|| true`) so a missing package here is non-fatal.
ENV FNM_DIR=/opt/fnm
# Offline-first: fnm zip + node tarball are pre-staged on the host in
# docker/context/fnm-node/ (prepare-fnm-node.sh). Network fallbacks kept
# so a context built without running prepare still succeeds.
COPY docker/context/fnm-node/ /tmp/fnm-pre/
RUN apt-get install -y --no-install-recommends curl unzip ca-certificates ncurses-term 2>/dev/null \
        || echo "WARN: curl/unzip install from offline cache failed; build may fail"; \
    set +e; \
    if [ -f /tmp/fnm-pre/fnm-linux.zip ]; then \
        unzip -o /tmp/fnm-pre/fnm-linux.zip -d /opt/fnm && chmod +x /opt/fnm/fnm; \
    else \
        if [ "${TARGETARCH}" = "arm64" ]; then FNM_ASSET="fnm-arm64.zip"; else FNM_ASSET="fnm-linux.zip"; fi; \
        curl -sSL -o /tmp/fnm.zip "https://github.com/Schniz/fnm/releases/download/v${FNM_VERSION}/${FNM_ASSET}" \
        && unzip /tmp/fnm.zip -d /opt/fnm && chmod +x /opt/fnm/fnm; \
    fi; \
    if [ -x /opt/fnm/fnm ]; then \
        # Node.js official tarballs are named {x64|arm64}, NOT Docker's
        # TARGETARCH (amd64). Map amd64 -> x64 so the pre-staged offline
        # tarball name matches; otherwise the offline path is skipped and
        # `fnm install 22` pulls the newest 22.x, drifting from the pinned
        # NODE22_VERSION (offline: 22.22.3 vs online: whatever is latest).
        if [ "${TARGETARCH}" = "amd64" ]; then NODE_ARCH="x64"; else NODE_ARCH="${TARGETARCH:-x64}"; fi; \
        if [ -f "/tmp/fnm-pre/node-v${NODE22_VERSION}-linux-${NODE_ARCH}.tar.xz" ]; then \
            echo "offline: extracting node v${NODE22_VERSION} from pre-staged tarball"; \
            mkdir -p /opt/nodejs/22 \
            && tar -xJf "/tmp/fnm-pre/node-v${NODE22_VERSION}-linux-${NODE_ARCH}.tar.xz" -C /tmp \
            && cp -rLP /tmp/node-v${NODE22_VERSION}-linux-${NODE_ARCH}/. /opt/nodejs/22/; \
        else \
            /opt/fnm/fnm install 22 --node-dist-mirror https://npmmirror.com/mirrors/node; \
            mkdir -p /opt/nodejs/22; \
            cp -rLP /opt/fnm/node-versions/v22.*/installation/. /opt/nodejs/22/ 2>/dev/null; \
        fi; \
    fi; \
    # NOTE: node 24 is currently unused (only node 22 is wired up via /opt/nodejs/22/
    # and the python-server / REPL-server / npm globals stack). Kept commented
    # out so the build does not pull a 50 MB tarball for nothing. Re-enable
    # here AND in §7 (the /opt/nodejs/24 symlink + node24 binary) if a future
    # variant needs node 24.
    # && /opt/fnm/fnm install 24 --node-dist-mirror https://mirrors.huaweicloud.com/nodejs \
    #     --archive-name-format=v{version}-{arch}-{libc}-{runtime}.tar.gz || /opt/fnm/fnm install 24 --node-dist-mirror https://cdn.npmmirror.com/binaries/node \
    #     --archive-name-format=v{version}-{arch}-{libc}-{runtime}.tar.gz \
    #     || echo "WARN: node 24 install failed; falling back to v22 alias only" \
    rm -rf /tmp/fnm.zip /tmp/fnm-pre /tmp/node-v${NODE22_VERSION}-linux-${NODE_ARCH} /opt/fnm/.lastupdate \
    && (test -x /opt/nodejs/22/bin/node || { echo "FATAL: node22 missing after install"; exit 1; }) \
    && ln -sf /opt/nodejs/22/bin/node /usr/local/bin/node \
    && ln -sf /opt/nodejs/22/bin/npm  /usr/local/bin/npm \
    && ln -sf /opt/nodejs/22/bin/node /usr/local/bin/node22 \
    && rm -rf /opt/fnm/node-versions

# ===== 7b. Node.js REPL server (recovered) =====
ARG NPM_REGISTRY
COPY docker/context/repl-servers/nodejs /opt/repl-servers/nodejs
# Offline-first: repl deps pre-staged as tgz by prepare-npm.sh. Fallback to
# the CN registry only if no tarballs are present or offline install fails.
COPY docker/context/npm-tgz/repl/ /tmp/npm-tgz/repl/
RUN cd /opt/repl-servers/nodejs && \
    if ls /tmp/npm-tgz/repl/*.tgz >/dev/null 2>&1; then \
        /usr/local/bin/node22 /usr/local/bin/npm install --omit=dev --no-fund --no-audit \
            --prefer-offline /tmp/npm-tgz/repl/*.tgz 2>/dev/null \
        || /usr/local/bin/node22 /usr/local/bin/npm install --omit=dev --no-fund --no-audit \
            --registry ${NPM_REGISTRY:-https://registry.npmmirror.com}; \
    else \
        /usr/local/bin/node22 /usr/local/bin/npm install --omit=dev --no-fund --no-audit \
            --registry ${NPM_REGISTRY:-https://registry.npmmirror.com}; \
    fi; \
    rm -rf /tmp/npm-tgz/repl; \
    test -x /opt/repl-servers/nodejs/node_modules/.bin/tsx || echo "WARN: repl deps incomplete"

# ===== 8. (removed) rust toolchain / agent-browser =====
# agent-browser (cargo install) never actually installed into the image;
# the vendored sources (cargo-vendored/, rustup-pre/) were dead weight.
# Both were deleted from docker/context; rust/cargo toolchain no longer needed.

# ===== 9. chrome / playwright / noVNC / websocat (pre-staged) =====
COPY docker/context/chrome-deb/ /opt/chrome-deb/
COPY docker/context/novnc/ /opt/novnc/
COPY docker/context/websocat/ /opt/websocat/
RUN bash -uc 'shopt -s nullglob; DEBS=(/opt/chrome-deb/*.deb); if [ "${#DEBS[@]}" -gt 0 ]; then apt-get install -y --no-install-recommends "${DEBS[@]}" || echo "WARN: chrome install failed"; fi' \
    && rm -rf /opt/chrome-deb

RUN bash -euc 'if [ ! -d /opt/novnc/noVNC ] && [ -d /opt/novnc ] && ls /opt/novnc/* >/dev/null 2>&1; then mkdir -p /opt/novnc/noVNC && cp -r /opt/novnc/. /opt/novnc/noVNC/ 2>/dev/null || true; fi; echo "noVNC staging done"'
RUN ln -sf vnc.html /opt/novnc/noVNC/index.html 2>/dev/null; echo "noVNC index.html symlink created"
# ui_fix.js: user-provided latest noVNC app/ui.js, kept as a dedicated file
# at docker/context/novnc/ui_fix.js so prepare-all.sh re-downloads (which
# overwrites docker/context/novnc/noVNC/app/ui.js) can never clobber it.
# Replace the noVNC-shipped ui.js right after installation.
COPY docker/context/novnc/ui_fix.js /opt/novnc/noVNC/app/ui.js

RUN bash -euc 'if [ -f /opt/websocat/websocat-x86_64-unknown-linux-musl ]; then install -m 0755 /opt/websocat/websocat-x86_64-unknown-linux-musl /usr/local/bin/websocat; else echo "WARN: websocat binary missing"; fi'

# ===== 10/11/12. python-server removed =====
# All venv build, rootfs helpers (build-fix-so, venv-patch, patch-browser-cdp,
# post-inst, supervisord-wirifier, sweep-so), source copy (browser-sdk,
# python-server) are gone. python-server is no longer required.
COPY docker/context/opt/application/init-once.sh /opt/application/init-once.sh
RUN chmod +x /opt/application/init-once.sh

# ===== 13. copy aio client + static assets + ve binaries =====
COPY --from=aio-build      /build/aio/dist/             /opt/aio/
RUN mkdir -p /var/www/app/static
COPY --from=static-assets  /out/var/www/app/static/sandbox /var/www/app/static/sandbox/
COPY --from=ve-build       /go/bin/ve                   /usr/local/bin/ve

# ===== 14. rootfs scripts (config files, no patch scripts) =====
COPY docker/context/rootfs/etc/                       /etc/
COPY docker/context/rootfs/opt/                       /opt/
COPY docker/context/rootfs/usr/local/bin/             /usr/local/bin/
RUN chmod +x /usr/local/bin/* 2>/dev/null || true; \
    chown -R 1000:1000 /opt/aio /var/www/app/static 2>/dev/null || true

# ===== 14a. (removed — was patching python-server venv) =====

# ===== 14b. browser config dir pre-create =====
RUN rm -rf /home/x/.config/browser && mkdir -p /home/x/.config/browser; \
    chown -R 1000:1000 /home/x/.config/browser 2>/dev/null || true

# ===== 14c. (removed — was app.logging rename in python-server venv) =====
RUN bash -c 'set -eux; \
    mkdir -p /etc/profile.d; \
    [ -f /opt/gem/nodejs.sh ] && ln -sf /opt/gem/nodejs.sh /etc/profile.d/nodejs.sh || true; \
    mkdir -p /var/www/app; \
    [ -d /opt/aio ] && ln -sfT /opt/aio /var/www/app/current 2>/dev/null || true; \
    if [ ! -e /var/www/app/index.html ] && [ -f /opt/aio/index.html ]; then \
        ln -sf /opt/aio/index.html /var/www/app/index.html; \
    fi; \
    echo "build-time inits baked into image"'

# ===== 14d. fcitx5 default profile (bake Ctrl+Shift trigger + pinyin default) =====
RUN mkdir -p /home/x/.config/fcitx5/conf && \
    cat > /home/x/.config/fcitx5/profile <<'FCITX_PROFILE_EOF'
[Groups/0]
Name=Default
Default Layout=us
DefaultIM=pinyin

[Groups/0/Items/0]
Name=keyboard-us
Layout=

[Groups/0/Items/1]
Name=pinyin
Layout=
FCITX_PROFILE_EOF
RUN cat > /home/x/.config/fcitx5/config <<'FCITX_CONFIG_EOF'
[Hotkey]
EnumerateWithTriggerKeys=True
EnumerateSkipFirst=False

[Hotkey/TriggerKeys]
0=Control+Shift_L
1=Control+Shift_R
2=Zenkaku_Hankaku
3=Hangul

[Hotkey/EnumerateForwardKeys]
0=Control+Shift_R

[Hotkey/EnumerateBackwardKeys]
0=Control+Shift_L

[Hotkey/ActivateKeys]
0=Hangul_Hanja

[Hotkey/DeactivateKeys]
0=Hangul_Romaja

[Behavior]
ActiveByDefault=False
ShowInputMethodInformation=True
DefaultPageSize=5
FCITX_CONFIG_EOF
RUN chown -R 1000:1000 /home/x/.config/fcitx5

# ===== 14e. dbus-session (real dbus-daemon launcher) =====
# conf source: docker/context/rootfs/opt/gem/supervisord/dbus-session.conf
RUN mkdir -p /tmp/runtime-x && chown 1000:1000 /tmp/runtime-x && chmod 700 /tmp/runtime-x

# ===== 14f. fcitx5 conf (autostart before chrome) =====
# conf source: docker/context/rootfs/opt/gem/supervisord/fcitx5.conf

# ===== 14g. hard-code ENV_ template strings in supervisord confs (build-time) =====
# Replace %(ENV_USER)s / %(ENV_DISPLAY)s / %(ENV_LOG_DIR)s etc. with
# hard-coded values so supervisord children inherit HOME=/home/x,
# USER=x, DISPLAY=:99. Same effect as v13-fix9.11 patch.
RUN set -e; \
    for f in /opt/gem/supervisord/*.conf; do \
        sed -i \
            -e 's|%(ENV_USER)s|x|g' \
            -e 's|%(ENV_DISPLAY)s|:99|g' \
            -e 's|%(ENV_LOG_DIR)s|/var/log/gem|g' \
            -e 's|%(ENV_AIO_DBUS_SESSION_SOCKET)s|/run/user/1000/dbus-session-bus|g' \
            -e 's|unix:path=/tmp/dbus-session-bus|unix:path=/run/user/1000/dbus-session-bus|g' \
            "$f" || true; \
    done; \
    echo "ENV_ template strings hard-coded in supervisord confs"

# ===== 14h. raise browser.conf priority so chrome spawns AFTER openbox/dbus =====
# base priority=100 caused a race: chrome ran before Xvnc/openbox, leaving
# an InputOnly root window no WM ever claimed → black screen on VNC.
RUN set -e; \
    if [ -f /opt/gem/supervisord/browser.conf ]; then \
        sed -i 's/^priority=100$/priority=920/' /opt/gem/supervisord/browser.conf; \
    fi; \
    echo "browser.conf priority raised to 920"

# ===== 14i. (removed) dead-code supervisord confs =====
# These confs (autocutsel*, dbus.conf, agent-browser.conf,
# supervisord.nodejs_repl_*.conf) and their companion scripts/binaries were
# deleted from docker/context/rootfs — they never reach the image now. The
# obsolete visible-chrome.conf is removed outright in 14j below: browser.conf
# is the sole chrome program, and a stale conf would show up in
# `supervisorctl status` (and could be mis-started by older launch scripts).

# ===== 14j. remove visible-chrome.conf + companion script =====
RUN rm -f /opt/gem/supervisord/visible-chrome.conf /opt/gem/start-visible-chrome.sh

# ===== 14k. /etc/environment — propagate ENV_* into every supervisord child =====
RUN { \
        echo "ENABLE_CJK_IME=true"; \
        echo "DISABLE_CODE=true"; \
        echo "DISABLE_JUPYTER=true"; \
        echo "DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/dbus-session-bus"; \
        echo "DISPLAY=:99"; \
        echo "ENV_DISPLAY=:99"; \
        echo "LOG_DIR=/var/log/gem"; \
        echo "PM2_HOME=/home/x/.pm2"; \
    } >> /etc/environment

# ===== 14l. npm-global PATH shim for npm exec =====
RUN printf '#!/bin/sh\n# final-version: let npm exec find PATH-installed chrome-devtools-mcp\nexport PATH="/home/x/.npm-global/bin:$PATH"\n' > /etc/profile.d/npm-global.sh && \
    chmod 644 /etc/profile.d/npm-global.sh

# ===== 14m. /home/x pre-create + .npm-cleanup + perms =====
# NOTE: every supervisord stdout_logfile/stderr_logfile path MUST be
# pre-created here, otherwise at first child startup supervisord logs
# "Failed to create stream fd: No such file or directory" while trying
# to open the logfile pipe. We pre-create ALL paths referenced anywhere
# in /opt/gem/supervisord/*.conf (including daytona/, fcitx5, dbus,
# browser, mcp-server-browser, openbox, nginx, vnc,
# websocat, reclaim-plugins, sandbox-pm2-runtime, sandbox-guard).
RUN mkdir -p \
        /var/log/gem \
        /var/log/gem/daytona \
        /var/log/gem/guard \
        /var/log/gem/reclaim-plugins \
        /var/log/gem/sandbox-pm2-runtime \
        /var/log/aio-sandbox \
        /tmp/runtime-x \
        /tmp/daytona-logs && \
    touch /var/log/gem/dbus-session.log \
          /var/log/gem/fcitx5.log \
          /var/log/gem/daytona/daytona.log \
          /var/log/gem/daytona/daytona_err.log \
          /var/log/gem/nginx.log \
          /var/log/gem/browser.log \
          /var/log/gem/openbox.log \
          /var/log/gem/tigervnc.log \
          /var/log/gem/websocat.log \
          /var/log/gem/mcp-server-browser.log \
          /var/log/gem/sandbox-pm2.log \
          /var/log/gem/sandbox-guard.log \
          /var/log/gem/log_tail.log \
          /tmp/dbus-session-bus \
          /tmp/daytona-daemon.log /tmp/daytona-entrypoint.log && \
    chown -R 1000:1000 /var/log/gem /var/log/aio-sandbox /tmp/runtime-x \
                       /tmp/dbus-session-bus /tmp/daytona-daemon.log \
                       /tmp/daytona-entrypoint.log /tmp/daytona-logs && \
    chmod 755 /var/log/gem /var/log/aio-sandbox && \
    chmod 700 /tmp/runtime-x && \
    chmod 644 /var/log/gem/*.log /var/log/gem/daytona/*.log && \
    chmod 664 /tmp/dbus-session-bus /tmp/daytona-daemon.log /tmp/daytona-entrypoint.log && \
    mkdir -p /home/x/.mcp2rest /home/x/.daemon/state /home/x/.daemon/logs /home/x/.daemon/locks \
              /home/x/.daemon/events /home/x/.daemon/apps /home/x/.daemon/work \
              /home/x/.claude /home/x/.claude-code-router /home/x/.pm2 /home/x/tmp \
              /home/x/.npm /home/x/.npm/_npx /home/x/.npm/_cacache \
              /home/x/.run && \
    chown -R 1000:1000 /home/x && \
    chmod -R 755 /home/x && \
    chmod 700 /home/x/.pm2 /home/x/.npm /home/x/.npm/_npx /home/x/.npm/_cacache /home/x/.run

# ===== 14m2. no-root runtime dirs (k8s runAsUser 1000 support) =====
# The container can be launched with `runAsUser: 1000` (user x) in k8s.
# At build time we pre-create every directory uid 1000 (or nobody, for the
# nginx workers) writes at runtime, otherwise startup dies with
# "mkdir: Permission denied" (e.g. /var/lib/aio-sandbox, /run/user/1000).
#   * /var/lib/aio-sandbox        -> init-once/run state + shutdown hooks
#   * /var/lib/aio-sandbox/nginx  -> nginx body/proxy/fastcgi/scgi/uwsgi temp (nobody)
#   * /var/lib/nginx              -> nginx cache dir (nobody, world-writable)
#   * /run/user/1000              -> XDG_RUNTIME_DIR + dbus session socket
#   * /etc/opt/chrome/policies/managed -> chrome enterprise policies
#     (google-chrome-stable deb reads THIS path, not /etc/browser/policies/
#     managed; pre-created + chowned so uid-1000 x can push policies at runtime)
#   * /opt/gem                    -> runtime-written nginx configs
RUN mkdir -p \
        /var/lib/aio-sandbox/nginx/body \
        /var/lib/aio-sandbox/nginx/proxy \
        /var/lib/aio-sandbox/nginx/fastcgi \
        /var/lib/aio-sandbox/nginx/scgi \
        /var/lib/aio-sandbox/nginx/uwsgi \
        /var/lib/nginx \
        /run/user/1000 \
        /etc/opt/chrome/policies/managed \
        /home/x/.ssh && \
    # Empty placeholder so the policy dir is never empty / missing; runtime
    # run.sh overwrites url_filter.json / dns_over_https.json from env.
    echo '{}' > /etc/opt/chrome/policies/managed/url_filter.json && \
    chown 1000:1000 /var/lib/aio-sandbox /var/lib/nginx /run/user/1000 \
                    /etc/opt/chrome/policies/managed \
                    /etc/opt/chrome/policies/managed/url_filter.json \
                    /home/x/.ssh && \
    chmod 700 /home/x/.ssh && \
    chown nobody:nogroup /var/lib/aio-sandbox/nginx /var/lib/aio-sandbox/nginx/* && \
    chmod 755 /var/lib/aio-sandbox /var/lib/aio-sandbox/nginx && \
    chmod 700 /run/user/1000 /var/lib/aio-sandbox/nginx/* && \
    chmod 1777 /var/lib/nginx && \
    chown -R 1000:1000 /opt/gem && \
    chmod -R u+rwX,g+rX,o+rX /opt/gem

# bare `supervisorctl status` reads /etc/supervisor/supervisord.conf (the deb
# default points at /var/run/supervisor.sock which does not exist here); link
# it to our x-writable socket config so both root and x can use it without
# -c / -s flags.
RUN ln -sf /opt/gem/supervisord.conf /etc/supervisor/supervisord.conf

# ===== 14n. mcp2rest config (no chrome-devtools-mcp@latest) =====
RUN printf 'servers:\n  chrome-devtools:\n    name: chrome-devtools\n    package: chrome-devtools-mcp\n    transport: stdio\n    args: ["--browser-url=http://127.0.0.1:9222"]\ngateway:\n  port: 28888\n  host: 0.0.0.0\n  timeout: 30000\n  logLevel: info\n' > /home/x/.mcp2rest/config.yaml && \
    chown 1000:1000 /home/x/.mcp2rest/config.yaml && \
    chmod 644 /home/x/.mcp2rest/config.yaml

# ===== 14o. daytona supervisord conf (user=x, rootless) =====
# conf source: docker/context/rootfs/opt/gem/supervisord/daytona.conf
RUN mkdir -p /home/x/.local/share/daytona && \
    touch /tmp/daytona-daemon.log /tmp/daytona-entrypoint.log && \
    touch /var/log/gem/daytona/daytona.log /var/log/gem/daytona/daytona_err.log && \
    chown 1000:1000 /tmp/daytona-daemon.log /tmp/daytona-entrypoint.log \
                    /var/log/gem/daytona/daytona.log /var/log/gem/daytona/daytona_err.log \
                    /home/x/.local/share/daytona

# ===== 14p. inject supervisord.conf environment line =====
# Top-level [supervisord] environment=DISPLAY=":99" guarantees chrome sees
# DISPLAY=:99 even when an entrypoint strips the env.
# NOTE: BROWSER_EXTRA_ARGS is intentionally NOT pinned here — run.sh composes
# it at runtime (--lang=${BROWSER_LANG_RESOLVED}, --time-zone-for-testing=${TZ},
# proxy args, BROWSER_NO_FIRST_RUN). Pinning it here would override those.
RUN sed -i '/^\[supervisord\]$/a environment=DISPLAY=":99"\nenvironment=DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/1000/dbus-session-bus"' /opt/gem/supervisord.conf && \
    grep -A4 '^\[supervisord\]$' /opt/gem/supervisord.conf

# ===== 14q. sandbox_guard (no-root Guard program bake) =====
# COPY from build context root: ./guard/ → /home/x/.daemon/
# Build context root is aio-sandbox/; ./guard/ is the consolidated sandbox_guard.
COPY guard/ /home/x/.daemon/

# Add 3 no-root Guard confs (sandbox-pm2-runtime, sandbox-guard-launcher, sandbox-daemon)
# Note: do NOT COPY docker/context/rootfs/opt/gem/supervisord/ wholesale — that would
# overwrite the patch-time edits above (dbus-session, fcitx5, browser priority,
# removed visible-chrome). Instead, additively COPY each Guard conf individually.
COPY docker/supervisord/sandbox-pm2-runtime.conf /opt/gem/supervisord/sandbox-pm2-runtime.conf
COPY docker/supervisord/sandbox-guard-launcher.conf /opt/gem/supervisord/sandbox-guard-launcher.conf
COPY docker/supervisord/sandbox-daemon.conf /opt/gem/supervisord/sandbox-daemon.conf

RUN set -e; \
    rm -f /home/x/.daemon/config.json; \
    mkdir -p /home/x/.data /home/x/.daemon/scripts; \
    find /home/x/.daemon -type d -name __pycache__ -prune -exec rm -rf {} + 2>/dev/null || true; \
    find /home/x/.daemon -type f \( -name "*.pyc" -o -name "*.pyo" \) -delete 2>/dev/null || true; \
    chmod +x /home/x/.daemon/sandbox_guard.py 2>/dev/null || true; \
    find /home/x/.daemon/scripts -type f -name "*.py" -exec chmod +x {} \; 2>/dev/null || true; \
    chown -R 1000:1000 /home/x/.daemon /home/x/.data /home/x/.pm2 /home/x/tmp; \
    test ! -e /home/x/.daemon/config.json && \
        echo "guard baked at /home/x/.daemon (no config.json)"

# ===== 14r. /opt/novnc chown x:x (nginx worker = nobody, still readable) =====
RUN chown -R 1000:1000 /opt/novnc && \
    chmod -R u+rwX,g+rX,o+rX /opt/novnc

# ===== 14r2. npx symlink + chown-shim wrapper (v13-fix9.11 fix restored) =====
# 2026-08-06 bug: my earlier 14r2 only did
#   ln -sf /opt/nodejs/22/bin/npx /usr/local/bin/npx
# but /opt/nodejs/22/bin/npx is a tiny shell wrapper (`exec node npx-cli.js`).
# node shebang parsing on a missing shebang or relative resolution can return
# ENOENT when spawned by mcp2rest (a node child process), causing
# "spawn npx ENOENT" on every browser-cli call.
#
# Fix: link /usr/local/bin/npx directly to the npx-cli.js file (the way
# v13-fix9.7 patch did), and add an npx-shim wrapper that auto-chowns
# /home/x/.npm before exec'ing the real npx — this prevents the no-root
# `npm exec` EACCES on root-owned /home/x/.npm/_npx.
RUN NPX_BIN=$(find / -path "*node_modules/npm/bin/npx-cli.js" 2>/dev/null | head -1) && \
    if [ -z "$NPX_BIN" ]; then echo "ERROR: npx-cli.js not found" >&2; exit 1; fi && \
    rm -f /usr/local/bin/npx && \
    ln -sf "$NPX_BIN" /usr/local/bin/npx && \
    rm -f /home/x/.npm-global/bin/npx /home/x/.npm-global/lib/node_modules/npx 2>/dev/null || true && \
    printf '#!/bin/sh\n# npx shim: chown any root-owned /home/x/.npm (no-restart reclaim) then exec real npx\nchown -R 1000:1000 /home/x/.npm 2>/dev/null\nexec /opt/nodejs/22/lib/node_modules/npm/bin/npx-cli.js "$@"\n' > /usr/local/bin/npx-shim && \
    chmod 755 /usr/local/bin/npx-shim && \
    echo "v13-fix9.11 npx restored: npx -> $NPX_BIN, npx-shim installed"

# ===== 14r3. mcp2rest config (NOT auto-started, deploy script will spawn) =====
# mcp2rest is the MCP-to-REST gateway that exposes browser/chrome-devtools
# tools over HTTP on :28888. The supervisord auto-start was REMOVED in
# v13-fix9.11 because:
#   1. mcp2rest startup pulls `chrome-devtools-mcp@1.6.0` via npm exec
#      (extra 30-60s on a slow link) and can race with browser CDP.
#   2. The deployment hook `sandbox_guard/.../create_policy_mcp2rest_port_ssl.py`
#      spawns mcp2rest on demand and writes the ready event to
#      /home/x/.daemon/events/. Bringing it up twice (supervisord + hook)
#      causes bind:28888 conflicts.
# We still bake the config + directories so the hook can launch it with
# a one-liner. /home/x/.mcp2rest/config.yaml is rendered from run.sh
# below; the directories here just create the empty layout for the hook.
# (Section 14n already created /home/x/.mcp2rest/ + config.yaml.)
RUN echo "v13-fix9.11: mcp2rest NOT auto-started via supervisord; deploy hook spawns it" && \
    rm -f /opt/gem/supervisord/mcp2rest.conf

# ===== 14r4. /opt/novnc/app/ overlay directory (deploy-time ui.js swap + baked patch) =====
# The deploy-time hook may scp a patched /opt/novnc/app/ui.js to this path to
# replace the noVNC-shipped one. The nginx vnc.conf has a `^~ /vnc/app/`
# location that prefers /opt/novnc/app/ over the baked /opt/novnc/noVNC/app/
# tree, so a custom ui.js here wins without rebuilding the image.
# v14: bake docker/context/novnc/app/ui.js (clipboard monitor patch) here so it
# survives prepare-all.sh (which re-downloads the vanilla noVNC tree).
COPY docker/context/novnc/app/ /opt/novnc/app/
RUN chown 1000:1000 /opt/novnc/app && \
    chmod 755 /opt/novnc/app && \
    test -f /opt/novnc/app/.gitkeep || touch /opt/novnc/app/.gitkeep && \
    echo "v14: /opt/novnc/app/ overlay baked with patched ui.js (chown x:x 755)"

# ===== 14r5. propagate ui_fix.js into the /opt/novnc/app/ overlay =====
# nginx vnc.conf serves /vnc/app/ui.js from /opt/novnc/app/ui.js (NOT the
# baked /opt/novnc/noVNC/app/ui.js tree), so the §9 ui_fix.js replacement
# must also land in the overlay, which §14r4 just re-baked from the older
# docker/context/novnc/app/ui.js (clipboard-monitor patch).
RUN cp -f /opt/novnc/noVNC/app/ui.js /opt/novnc/app/ui.js && \
    chown 1000:1000 /opt/novnc/app/ui.js && chmod 644 /opt/novnc/app/ui.js && \
    echo "14r5: ui_fix.js propagated to /opt/novnc/app/ui.js (nginx-served copy)"

# ===== 14s. PYTHONHTTPSVERIFY off for vendored wheels fetch =====
ENV PYTHONHTTPSVERIFY=0 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    REQUESTS_CA_BUNDLE=""

# ===== 15. global npm packages (claude-code, mcp2rest, pm2, chrome-devtools-mcp) =====
ARG NPM_REGISTRY
ARG MCP_SERVER_BROWSER_VERSION
# Offline-first: every resolved dep (incl. transitive) is pre-staged as tgz
# by prepare-npm.sh into npm-tgz/global/. `npm install -g *.tgz` installs all
# of them in one tree so satisfied deps never touch the registry; fallback to
# the CN registry only when no tarballs exist or the offline install fails.
COPY docker/context/npm-tgz/global/ /tmp/npm-tgz/global/
RUN export PATH="/usr/local/bin:$PATH" \
    && if ls /tmp/npm-tgz/global/*.tgz >/dev/null 2>&1; then \
         npm install -g --no-fund --no-audit --prefer-offline /tmp/npm-tgz/global/*.tgz 2>/dev/null \
         || npm install -g --no-fund --no-audit --registry ${NPM_REGISTRY} \
            tsx@^4.19.2 \
            typescript@^5.0.0 \
            mcp2rest \
            pm2@7.0.3 \
            @agent-infra/mcp-server-browser@${MCP_SERVER_BROWSER_VERSION} \
            chrome-devtools-mcp@0.21.0 \
            playwright@1.56.0; \
       else \
         npm install -g --no-fund --no-audit --registry ${NPM_REGISTRY} \
            tsx@^4.19.2 \
            typescript@^5.0.0 \
            mcp2rest \
            @anthropic-ai/claude-agent-sdk@0.2.63 \
            pm2@7.0.3 \
            @agent-infra/mcp-server-browser@${MCP_SERVER_BROWSER_VERSION} \
            chrome-devtools-mcp@0.21.0 \
            playwright@1.56.0; \
       fi; \
    rm -rf /tmp/npm-tgz/global \
    && ln -sf /home/x/.npm-global/bin/mcp-server-browser /usr/local/bin/mcp-server-browser \
    && chown -R 1000:1000 /home/x/.npm-global /home/x/.npm /home/x/.npmrc 2>/dev/null || true \
    && find /home/x/.npm-global/bin -maxdepth 1 -type f -exec chmod +x {} \; 2>/dev/null || true \
    && chown -R 1000:1000 /home/x

# mcp2rest spawns chrome-devtools-mcp via `npx chrome-devtools-mcp` (hardcoded
# in mcp2rest 0.6.x StdioClientTransport). npx only resolves cwd's
# node_modules/.bin before falling back to the registry, so without a local
# copy it re-downloads chrome-devtools-mcp@latest (1.x) on every start. On the
# isolated intranet that stalls past the gateway's 30s connect timeout and the
# client sees `MCP error -32001: request timed out`. Symlink the pinned global
# install into /home/x/node_modules/.bin so npx resolves it instantly (both the
# daemon cwd /home/x/.daemon and any pm2 cwd sit under /home/x).
RUN mkdir -p /home/x/node_modules/.bin \
    && ln -sf /home/x/.npm-global/bin/chrome-devtools-mcp /home/x/node_modules/.bin/chrome-devtools-mcp \
    && chown -R 1000:1000 /home/x/node_modules

# ===== 15a. daytona daemon + computer-use plugin =====
# daytona execs the plugin binary directly at /usr/local/lib/daytona-computer-use
# (a single FILE, not a directory) — keep the layout flat or fork/exec fails
# with EACCES "permission denied". Must be the Linux ELF build, not the
# Windows PE artifact that some mirror URLs return.
COPY docker/context/bin/daytona /usr/local/bin/daytona
RUN chmod +x /usr/local/bin/daytona
COPY docker/context/dist/libs/computer-use-amd64 /usr/local/lib/daytona-computer-use
RUN chmod 755 /usr/local/lib/daytona-computer-use \
    && chown 1000:1000 /usr/local/lib/daytona-computer-use

# ===== 16. (removed — was pip3 install requests for python-server) =====

# ===== 17. apt cache cleanup =====
RUN rm -rf /var/cache/apt/archives/*.deb /var/lib/apt/lists/* \
           /opt/wheels /opt/apt-archives \
           /root/.cache /tmp/*.tmp /tmp/*.tar.* /tmp/*.zip /tmp/*.deb 2>/dev/null || true; \
    rm -rf /tmp/npm-tgz /tmp/requirements /tmp/active.conf 2>/dev/null || true; \
    rm -rf /root/.cargo/registry/cache /root/.cargo/git 2>/dev/null || true; \
    rm -rf /root/.npm /root/.node-gyp 2>/dev/null || true; \
    rm -rf /var/log/apt/* /var/log/dpkg.log /var/log/bootstrap.log 2>/dev/null || true; \
    rm -rf /usr/share/doc/* /usr/share/man/* 2>/dev/null || true; \
    # Delete static libs EXCEPT /usr/lib/gcc/** and libc_nonshared.a:
    # gcc linking needs libgcc.a/libgcc_eh.a (`-lgcc`) AND glibc's
    # libc_nonshared.a (__register_atfork etc.) — removing them breaks every
    # compile ("cannot find -lgcc" / "cannot find libc_nonshared.a").
    find /usr/lib /lib -name '*.a' ! -path '/usr/lib/gcc/*' \
        ! -name 'libc_nonshared.a' -type f -delete 2>/dev/null || true; \
    rm -rf /usr/share/locale/?? /usr/share/locale/??_?? \
           /usr/share/locale/??_??.* /usr/share/locale/en@* \
           /usr/share/locale/[^a]* 2>/dev/null || true; \
    echo "image cleanup done"

# ===== 18. Deep cleanup: drop unused files for size =====
# NOTE: NO dpkg --purge of toolchain/system packages here. Purging gcc-15 /
# g++-15 / cpp-15 / libc6-dev / build-essential left meta packages (gcc, g++,
# cpp) with dangling /usr/bin/gcc -> gcc-15 symlinks AND a broken apt state
# (ffmpeg/qt/etc. deps gone), so `gcc` vanished and any future
# `sudo apt-get install` failed. gcc must stay for the sandbox user, so we
# keep all packages and only delete caches/unused files.
RUN npm uninstall -g typescript tsx 2>/dev/null || true; \
    rm -rf /home/x/.npm-global/lib/node_modules/bun \
           /home/x/.npm-global/lib/node_modules/typescript \
           /home/x/.npm-global/lib/node_modules/tsx 2>/dev/null || true; \
    npm cache clean --force 2>/dev/null || true; \
    rm -rf /home/x/.npm/_cacache 2>/dev/null || true; \
    apt-get update -qq 2>/dev/null; \
    if apt-get install -y --no-install-recommends vim-tiny; then \
        echo "vim-tiny installed; dropping full vim"; \
        dpkg --purge --force-all vim vim-runtime 2>/dev/null || true; \
    else \
        echo "WARN: vim-tiny install failed; keeping full vim"; \
    fi; \
    # vim-common MUST stay: it owns the vi/vim alternatives symlinks that
    # vim-tiny relies on. Purging it is what broke `vi`/`vim` before.
    update-alternatives --set vi /usr/bin/vim.tiny 2>/dev/null || true; \
    update-alternatives --set vim /usr/bin/vim.tiny 2>/dev/null || true; \
    rm -rf /tmp/chrome-profile 2>/dev/null || true; \
    rm -f /usr/share/fonts/opentype/noto/NotoSerifCJK-ExtraLight.ttc \
          /usr/share/fonts/opentype/noto/NotoSerifCJK-Light.ttc \
          /usr/share/fonts/opentype/noto/NotoSerifCJK-Medium.ttc \
          /usr/share/fonts/opentype/noto/NotoSerifCJK-SemiBold.ttc \
          /usr/share/fonts/opentype/noto/NotoSerifCJK-Bold.ttc \
          /usr/share/fonts/opentype/noto/NotoSerifCJK-Black.ttc \
          /usr/share/fonts/opentype/noto/NotoSansCJK-Black.ttc \
          2>/dev/null || true; \
    rm -rf /var/cache/apt/archives/*.deb /var/lib/apt/lists/* 2>/dev/null || true; \
    # NOTE: /usr/libexec/gcc and /usr/include MUST stay — gcc's internal
    # compiler binaries (cc1, cc1plus, collect2) and C headers live there.
    rm -rf /opt/nodejs/22/include \
           /opt/fnm /usr/libexec/glycin-loaders \
           /usr/lib/cargo \
           2>/dev/null || true; \
    rm -f /usr/bin/x86_64-linux-gnu-lto-dump-15 \
          /usr/bin/snap /usr/bin/ctest /usr/bin/cpack /usr/bin/cmake \
          /usr/bin/pebble \
          2>/dev/null || true; \
    rm -rf /usr/lib/udev /usr/share/gir-1.0 /usr/lib/file 2>/dev/null || true; \
    rm -f /usr/local/bin/uv /usr/local/bin/uvx 2>/dev/null || true; \
    find /usr/share/terminfo -type f ! -name 'xterm*' ! -name 'vt100*' ! -name 'linux*' ! -name 'screen*' -delete 2>/dev/null || true; \
    find /usr/share/i18n/locales -type f ! -name 'en_*' ! -name 'zh_*' ! -name 'i18n' ! -name 'iso14651_t1*' -delete 2>/dev/null || true; \
    rm -rf /usr/share/icons/Adwaita /usr/share/icons/AdwaitaLegacy 2>/dev/null || true; \
    apt-get check >/dev/null 2>&1 && echo "apt OK" || echo "WARN: apt unmet deps"; \
    command -v gcc && gcc --version | head -1; \
    echo "deep cleanup done"

# (Removed — was rebuilding .pyc cache for python-server venv)

# =============================================================================
# Stage 6 — squash: single layer from builder
# =============================================================================
FROM ubuntu:26.04
COPY --from=builder / /
ENV DEBIAN_FRONTEND=noninteractive
# China Standard Time — must be declared here (final stage): the squash
# stage only COPYs files from builder, ENV metadata does NOT carry over.
ENV TZ=Asia/Shanghai
ENV USER=x
ENV USER_UID=1000
ENV USER_GID=1000
ENV HOME=/home/x
ENV NPM_CONFIG_PREFIX=/home/x/.npm-global
ENV NPM_CONFIG_CACHE=/home/x/.npm
ENV PATH=/home/x/.npm-global/bin:/home/x/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ENV ANTHROPIC_BASE_URL=http://127.0.0.1:3456
ENV ANTHROPIC_MODEL=CMB_Model
ENV ANTHROPIC_SMALL_FAST_MODEL=CMB_Model
ENV CLAUDE_AUTOCOMPACT_PCT_OVERRIDE=70
ENV ANTHROPIC_AUTH_TOKEN=your-secret-key
ENV DAYTONA_DAEMON_LOG_FILE_PATH=/tmp/daytona-daemon.log
ENV DAYTONA_ENTRYPOINT_LOG_FILE_PATH=/tmp/daytona-entrypoint.log
ENV DAYTONA_USER_HOME_AS_WORKDIR=true
ENV LOG_LEVEL=info
ENV BROWSER_EXTRA_ARGS="--disable-setuid-sandbox --no-zygote --window-position=0,0 --window-size=1280,1024"
# Skip Chrome first-run wizard + sign-in prompt (BROWSER_NO_FIRST_RUN=false to restore)
ENV BROWSER_NO_FIRST_RUN=true
ENV DISABLE_JUPYTER=true
ENV PUBLIC_PORT=8080 \
    VNC_SERVER_PORT=5900 \
    WEBSOCKET_PROXY_PORT=5700 \
    SANDBOX_SRV_PORT=9988 \
    JUPYTER_LAB_PORT=8888 \
    CODE_SERVER_PORT=8443 \
    MCP_SERVER_BROWSER_PORT=8100 \
    BROWSER_REMOTE_DEBUGGING_PORT=9222 \
    BROWSER_EXECUTABLE_PATH=/opt/google/chrome/chrome \
    PUPPETEER_EXECUTABLE_PATH=/opt/google/chrome/chrome \
    AGENT_BROWSER_EXECUTABLE_PATH=/opt/google/chrome/chrome \
    BROWSER_COMMANDLINE_ARGS="--no-sandbox --disable-dev-shm-usage --disable-gpu --remote-allow-origins=* --remote-debugging-port=9222 --remote-debugging-address=0.0.0.0 --start-maximized --disable-blink-features=AutomationController --disable-features=IPH_DesktopCustomizeChrome,IsolateOrigins,site-per-process --disable-focus-on-load --disable-infobars --disable-popup-blocking --disable-prompt-on-repost --disable-renderer-backgrounding --disable-site-isolation-trials --disable-window-activation --mute-audio --suppress-message-center-popups --homepage=about:blank --disable-background-timer-throttling --disable-external-intent-requests" \
    PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true

# Image version + supervisor runtime user (declared here in the final stage:
# the squash stage only COPYs files from builder, ENV metadata does NOT
# carry over).
ENV AIO_SANDBOX_VERSION=0.2.0 \
    SUPERVISOR_USER=x

# pip: redirect "global" installs to the per-user base so uid-1000 x can
# `pip install <pkg>` with no root. PEP 668 (EXTERNALLY-MANAGED) would still
# block even --user mode, so break-system-packages is enabled (user-level
# installs into /home/x/.local, system tree untouched). Verified at runtime:
# pip install --dry-run six -> "Would install six-1.17.0".
ENV PIP_USER=1 \
    PYTHONUSERBASE=/home/x/.local \
    PIP_BREAK_SYSTEM_PACKAGES=1

# Internal mirror (招行 intranet) — switchable via build-arg
# NOTE: this RUN runs as root with HOME=/home/x, so the files land in
# /home/x but are owned by root. .npmrc is 0600 root → x (uid 1000, the
# runtime user) canNOT read it and npm silently falls back to the public
# registry. chown fixes both npm (0600) and pip (0644) configs.
RUN npm config set registry http://central.jaf.cmbchina.cn/artifactory/api/npm/group-npm/ \
    && pip config set global.index-url http://central.jaf.cmbchina.cn/artifactory/api/pypi/group-pypi/simple \
    && pip config set global.trusted-host central.jaf.cmbchina.cn \
    && pip config set central.jaf.cmbchina.cn install.trusted-host \
    && chown 1000:1000 /home/x/.npmrc /home/x/.config/pip/pip.conf \
    && chmod 600 /home/x/.npmrc \
    && chmod 644 /home/x/.config/pip/pip.conf

EXPOSE 8080 2280

# Entrypoint: init-once.sh → run.sh → supervisord
# All port defaults via ENV; nginx configs rendered at runtime.
CMD ["/opt/application/init-once.sh"]