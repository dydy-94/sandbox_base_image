# =============================================================================
# 行尾统一为 LF
#
# 背景：仓库里原本存的就是 LF，但 Windows 上 Git 默认 core.autocrlf=true，
# 会在检出时把 LF 转成 CRLF。Dockerfile.final 用 COPY 直接读工作区文件，
# 于是 CRLF 被原样打进镜像 —— 其中 run.sh / init-once.sh 的 shebang 会变成
# "#!/bin/bash\r"，内核 exec 时找不到该解释器，容器直接启动失败。
#
# eol 属性的优先级高于 core.autocrlf，所以本文件一旦存在，无论开发者在
# Windows / macOS / Linux 上检出，工作区都固定为 LF。
# =============================================================================

# 所有文本文件一律 LF
* text=auto eol=lf

# 明确声明为二进制，禁止任何行尾转换（离线 apt/pip/npm 缓存里有大量 .deb/.whl）
*.deb binary
*.whl binary
*.gz binary
*.tgz binary
*.tar binary
*.zip binary
*.xz binary
*.bz2 binary

# 图片 / 字体 / 其它二进制资产
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.bmp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.pdf binary

# 原生库 / 可执行文件
*.so binary
*.so.* binary
*.a binary
*.dll binary
*.dylib binary
*.exe binary
*.bin binary

# 媒体
*.mp4 binary
*.webm binary
*.mp3 binary
*.ogg binary
*.wasm binary
